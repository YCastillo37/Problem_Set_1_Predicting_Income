# Generamos tabla con estadisticas descriptivas

# Función para calcular la moda
moda <- function(x) {
  ux <- na.omit(unique(x))
  ux[which.max(tabulate(match(x, ux)))]
}

#Estadísticas para variables numéricas
tabla_cont <- df_2 %>%
  summarise(
    Edad_N = sum(!is.na(age)),
    Edad_Media = mean(age, na.rm = TRUE),
    Edad_Mediana = median(age, na.rm = TRUE),
    Edad_Moda = moda (age),
    P7422s1_N = sum(!is.na(p7422s1)),
    P7422s1_Media = mean(p7422s1, na.rm = TRUE),
    P7422s1_Mediana = median(p7422s1, na.rm = TRUE),
    P7422s1_Moda =moda (p7422s1)
  ) %>%
  pivot_longer(everything(),
               names_to = c("Variable", ".value"),
               names_pattern = "(.*)_(.*)")

# Estadísticas para estrato (solo N y moda)
tabla_estrato <- df_2 %>%
  summarise(
    N = sum(!is.na(estrato1)),
    Moda = moda (estrato1)
  ) %>%
  mutate(Variable = "Estrato1",
         Media = NA,
         Mediana = NA) %>%
  select(Variable, N, Media, Mediana, Moda)

# Unimos ambas tablas
tabla_estadisticas <- bind_rows(tabla_cont, tabla_estrato) %>%
  select(Variable, N, Media, Mediana, Moda)

# Generamos la tabla en LaTeX
